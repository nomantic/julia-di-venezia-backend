APP_ENV=dev
PORT=3000
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=change-this-to-a-secure-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-this-password

# Comma-separated list of browser origins allowed in production, e.g. https://your-storefront.web.app
CORS_ORIGINS=

# Storefront URL for transactional emails
STOREFRONT_URL=http://localhost:3001

# Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Database Configuration (PostgreSQL / Supabase)
DB_TYPE=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=true

# S3 / Supabase S3 Storage Configuration
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
